# Copy to .env and edit. Never commit the real .env.

# Port the server listens on.
PORT=3000

# The HTTPS origin recipients will reach. This is what gets baked into every
# signing link, so it MUST be the public URL, not localhost.
# Local testing with a tunnel:  PUBLIC_URL=https://your-id.ngrok-free.app
PUBLIC_URL=http://localhost:3000

# Protects the sender API. Leave blank and the server generates one on first
# boot and writes it to data/api-key.txt.
API_KEY=

# Where uploads and db.json live. Point this at a persistent disk in production.
DATA_DIR=./data

# Durable storage, for hosts whose disk does not survive a restart (Render's
# free plan wipes it). Leave BLANK and the app behaves exactly as it always
# has, keeping everything under DATA_DIR only.
#
# Set it, and both the records and the document bytes are mirrored to MongoDB
# and reloaded at boot, so nothing is lost when the disk is recycled. A free
# MongoDB Atlas cluster is enough.
#   MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name inside that cluster (optional).
MONGODB_DB=mobile_signature

# Max PDF upload size in bytes (default 20 MB).
MAX_UPLOAD_BYTES=20971520

# How long a signing link stays valid, in hours (default 168 = 7 days).
LINK_TTL_HOURS=168
